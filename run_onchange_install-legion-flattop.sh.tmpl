{{- if eq .chezmoi.hostname "flattop" -}}
#!/usr/bin/env bash
# Installs the legion-flattop system files (kernel-module patcher,
# fan-max systemd unit, modprobe options, pacman hook) from the chezmoi-
# managed source copies in ~/.local/share/legion-flattop/ to their system
# locations. Re-runs whenever any tracked source changes (via the embedded
# checksums below).
#
# Source file checksums:
# legion-vpc2004-patch.sh: {{ include "dot_local/share/legion-flattop/executable_legion-vpc2004-patch.sh" | sha256sum }}
# legion-fancontrol-setup.sh: {{ include "dot_local/share/legion-flattop/executable_legion-fancontrol-setup.sh" | sha256sum }}
# zz-legion-vpc2004-patch.hook: {{ include "dot_local/share/legion-flattop/zz-legion-vpc2004-patch.hook" | sha256sum }}
# legion-laptop.conf: {{ include "dot_local/share/legion-flattop/legion-laptop.conf" | sha256sum }}
# legion-fancontrol.service: {{ include "dot_local/share/legion-flattop/legion-fancontrol.service" | sha256sum }}

set -euo pipefail
SRC="$HOME/.local/share/legion-flattop"

sudo install -m 0755 "$SRC/legion-vpc2004-patch.sh"      /usr/local/sbin/legion-vpc2004-patch.sh
sudo install -m 0755 "$SRC/legion-fancontrol-setup.sh"   /usr/local/sbin/legion-fancontrol-setup.sh
sudo install -m 0644 "$SRC/zz-legion-vpc2004-patch.hook" /etc/pacman.d/hooks/zz-legion-vpc2004-patch.hook
sudo install -m 0644 "$SRC/legion-laptop.conf"           /etc/modprobe.d/legion-laptop.conf
sudo install -m 0644 "$SRC/legion-fancontrol.service"    /etc/systemd/system/legion-fancontrol.service

sudo systemctl daemon-reload
sudo systemctl enable --now legion-fancontrol.service

echo "legion-flattop: system files installed"
{{- else -}}
#!/usr/bin/env bash
# legion-flattop fixes only apply on flattop (Lenovo Legion 7 16ACHg6); skipping.
true
{{- end -}}
