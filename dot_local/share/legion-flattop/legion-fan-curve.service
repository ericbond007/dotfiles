[Unit]
Description=Lenovo Legion fan curve via patched legion-laptop
Documentation=https://github.com/johnfanv2/LenovoLegionLinux
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service
ConditionVirtualization=!container

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/services/legion-flattop/bin/legion-fan-curve.sh

[Install]
WantedBy=multi-user.target
