#!/bin/sh
# chezmoi modify_ script for ~/.claude/settings.json
#
# settings.json is CO-MANAGED: chezmoi must enforce the fleet-critical
# `permissions.allow` + `hooks` (incl. per-host hook blocks), but Claude Code
# rewrites `enabledPlugins`, `effortLevel`, `editorMode`,
# `remoteControlAtStartup`, `agentPushNotifEnabled`, `mcpServers`, ... at
# runtime per host. A full-file template fights those runtime writes and
# makes `chezmoi update` abort (drift prompt, no TTY over ssh) — which had
# silently frozen wanda out of all dotfile syncs.
#
# Contract: chezmoi pipes the current target file on stdin (empty if
# absent); our stdout becomes the new file. We:
#   - seed the runtime keys from template defaults (fresh host only),
#   - preserve whatever Claude Code wrote for them on existing hosts,
#   - force `.permissions.allow` and `.hooks` from the chezmoi-managed
#     (templated, hostname-conditional) values every run;
#   - force `.permissions.defaultMode` to "default" on every host EXCEPT
#     flattop (Dave's pick, 2026-11-02, aiImprove audit §3.2): flattop runs
#     Claude Code in "auto" mode by choice, and the old whole-object force
#     silently reset it on every apply/sync. The service hosts stay pinned.
#     The merge is a shallow jq `+`: every key MANAGED defines (`allow`, and a
#     future `deny`) replaces the runtime value wholesale (arrays are not
#     combined); keys MANAGED does not define (`deny`, `ask`,
#     `additionalDirectories`, `disableBypassPermissionsMode`, …) are KEPT —
#     note `additionalDirectories` widens access and now survives on service
#     hosts too (accepted with this choice; it only appears via /add-dir).
#     A non-object `.permissions` is treated as absent (`objects // {}`).
# Per-host runtime permission grants belong in settings.local.json (not
# chezmoi-tracked) per CLAUDE.md, so force-replacing .permissions.allow is correct.
# The vikunja.mjs allows (Dave, 2026-11-07: "you are absolutely allowed to groom the board"): auto
# mode's classifier blocked a "check VK" grooming batch as an external-system write. The two rules
# (absolute path and ~/ form) admit only the bundled Vikunja client, called by its literal path — not
# node in general, not a `$VK` variable, and not a script that shells out to it; those still go to
# the classifier, so the using-vikunja skill tells Claude to call the full path. They apply on EVERY
# host: on flattop (auto mode) they skip the classifier; on wanda/serp (defaultMode "default") they
# remove the prompt. The client has no task/project delete (its one DELETE removes a label); Bash
# hooks (bash-guards, the service-host hooks) still run first and can still block.
# NOTE: on flattop `chezmoi status` shows this file as `MM` even when nothing
# needs changing: Claude Code rewrites it in its own key order, we emit `jq -S`
# sorted keys. The success test for this script is a SEMANTIC diff (`jq -S`
# both sides), not a clean status. Reverting this commit + applying puts
# flattop back in "default" mode — expected, not a new bug; Dave re-picks auto.
#
# Host-conditional hook blocks (Dave, 2026-11-04, aiImprove audit §3.7 "serp hooks"):
#   wanda + serpentii (the service hosts; serp reports hostname "serpentii"): block-service-owned-files,
#     firewall-validate, pre-commit-secrets-scan, firewall-post-edit — each guards something both hosts
#     have (nftables; a /opt/services git repo with service-owned files). The two edit blockers also
#     watch NotebookEdit (notebook_path) since 2026-11-05. The Claude-side secrets scan
#     covers a commit of an already-staged index only; the usual add-and-commit form is covered just by
#     the repo's own .githooks/pre-commit, which both service hosts carry (serp since 2026-11-04).
#   wanda only: block-generated-files (rendered-secret .tpl pairs exist only there) and
#     wiki-update-reminder (the wiki lives there).
#   The two Bash ones are old wanda registrations extended as-is, not folded into bash-guards.sh:
#     any byte change there moves the Codex hash pin (see hooks/tests/codex-hash-pin.test.sh).
#
# security-guidance plugin seeded FALSE (Dave, 2026-11-03, aiImprove audit §3.6): one useful
# injection in 1,422 transcripts vs seven Python spawns on most Bash calls; disabled live on
# flattop/wanda/serp with `claude plugin disable … --scope user` (new sessions only).
# Re-enable = `claude plugin enable …` per host; the seed only reaches fresh hosts.
# jq is a documented fleet dependency (onboarding step 1); fail loudly if absent.
set -eu

command -v jq >/dev/null 2>&1 || { echo "modify_settings.json: jq not found" >&2; exit 1; }

MANAGED='{
  "permissions": {
    "allow": [
      "Bash(pacman *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(systemctl *)",
      "Bash(uname *)",
      "Bash(zramctl *)",
      "Bash(findmnt *)",
      "Bash(pactl *)",
      "Bash(echo *)",
      "Bash(tuned-adm *)",
      "Bash(grep *)",
      "Bash(node {{ .chezmoi.homeDir }}/.claude/skills/using-vikunja/scripts/vikunja.mjs *)",
      "Bash(node ~/.claude/skills/using-vikunja/scripts/vikunja.mjs *)"
    ]{{ if ne .chezmoi.hostname "flattop" }},
    "defaultMode": "default"{{ end }}
  },
  "hooks": {
    "Notification": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "~/.claude/hooks/notify-tmux.sh" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write", "hooks": [ { "type": "command", "command": "~/.claude/hooks/chezmoi-preflight.sh" } ] },
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "~/.claude/hooks/bash-guards.sh" } ] }{{ if eq .chezmoi.hostname "wanda" }},
      { "matcher": "Edit|Write|NotebookEdit", "hooks": [ { "type": "command", "command": "~/.claude/hooks/block-generated-files.sh" } ] }{{ end }}{{ if or (eq .chezmoi.hostname "wanda") (eq .chezmoi.hostname "serpentii") }},
      { "matcher": "Edit|Write|NotebookEdit", "hooks": [ { "type": "command", "command": "~/.claude/hooks/block-service-owned-files.sh" } ] },
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "~/.claude/hooks/firewall-validate.sh" } ] },
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "~/.claude/hooks/pre-commit-secrets-scan.sh" } ] }{{ end }}
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [ { "type": "command", "command": "~/.claude/hooks/chezmoi-readd.sh" } ] }{{ if or (eq .chezmoi.hostname "wanda") (eq .chezmoi.hostname "serpentii") }},
      { "matcher": "Edit|Write", "hooks": [ { "type": "command", "command": "~/.claude/hooks/firewall-post-edit.sh" } ] }{{ end }}{{ if eq .chezmoi.hostname "wanda" }},
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "~/.claude/hooks/wiki-update-reminder.sh" } ] }{{ end }}
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/code-review-before-done.sh" } ] }
    ]
  }
}'

SEED='{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "playwright@claude-plugins-official": {{ if eq .chezmoi.hostname "flattop" }}false{{ else }}true{{ end }},
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "editorMode": "vim",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "statusLine": { "type": "command", "command": "node \"$HOME/.claude/hooks/statusline.js\"" }{{ if eq .chezmoi.hostname "flattop" }},
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@0.0.77", "--browser=chromium", "--executable-path=/usr/bin/chromium", "--headless"]
    }
  }{{ end }}
}'

cur="$(cat)"
[ -n "$cur" ] || cur='{}'

printf '%s' "$cur" | jq -S \
  --argjson managed "$MANAGED" \
  --argjson seed "$SEED" \
  '($seed * .) | .permissions = (((.permissions | objects) // {}) + $managed.permissions) | .hooks = $managed.hooks'
