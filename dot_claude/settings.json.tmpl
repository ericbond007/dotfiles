{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(pacman *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(systemctl *)",
      "Bash(uname *)",
      "Bash(zramctl *)",
      "Bash(findmnt *)",
      "Bash(pactl *)",
      "Bash(echo *)",
      "Bash(tuned-adm *)",
      "Bash(grep *)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "playwright@claude-plugins-official": {{ if eq .chezmoi.hostname "flattop" }}false{{ else }}true{{ end }},
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "editorMode": "vim",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,{{ if eq .chezmoi.hostname "flattop" }}
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--browser", "chrome", "--executable-path", "/usr/bin/chromium"]
    }
  },{{ end }}
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/notify-tmux.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/chezmoi-preflight.sh" }
        ]
      }{{ if eq .chezmoi.hostname "wanda" }},
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/block-generated-files.sh" }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/block-service-owned-files.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/firewall-validate.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/pre-commit-secrets-scan.sh" }
        ]
      }{{ end }}
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/chezmoi-readd.sh" }
        ]
      }{{ if eq .chezmoi.hostname "wanda" }},
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/firewall-post-edit.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/wiki-update-reminder.sh" }
        ]
      }{{ end }}
    ]
  }
}
