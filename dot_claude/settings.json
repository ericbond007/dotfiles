{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(pacman *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(systemctl *)",
      "Bash(uname *)",
      "Bash(zramctl *)",
      "Bash(findmnt *)",
      "Bash(pactl *)",
      "Bash(echo *)",
      "Bash(tuned-adm *)",
      "Bash(grep *)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/notify-tmux.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/chezmoi-preflight.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/chezmoi-readd.sh" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/chezmoi-sync.sh" }
        ]
      }
    ]
  }
}
