{{ if stat "/usr/share/cachyos-fish-config/cachyos-config.fish" }}
source /usr/share/cachyos-fish-config/cachyos-config.fish
{{ end }}
alias vi='nvim'
alias reload='source ~/.config/fish/config.fish'
set -gx VISUAL nvim
set -gx EDITOR nvim
fnm env --use-on-cd | source

# 1Password Service Account — sourced from file, not hardcoded
if test -r /etc/op-service-account-token
    set -gx OP_SERVICE_ACCOUNT_TOKEN (cat /etc/op-service-account-token)
end

# GitHub token for MCP servers (github plugin) — pulled from gh CLI login, never stored.
# Only export when non-empty: an empty token makes the MCP server reject the
# Authorization header outright (HTTP 400), which is worse than no header.
if status is-interactive; and command -q gh
    set -l _gh_token (gh auth token 2>/dev/null)
    if test -n "$_gh_token"
        set -gx GITHUB_PERSONAL_ACCESS_TOKEN $_gh_token
    end
end

