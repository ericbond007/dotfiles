{{ if stat "/usr/share/cachyos-fish-config/cachyos-config.fish" }}
source /usr/share/cachyos-fish-config/cachyos-config.fish
{{ end }}
alias vi='nvim'
alias reload='source ~/.config/fish/config.fish'
set -gx VISUAL nvim
set -gx EDITOR nvim
fnm env --use-on-cd | source

# 1Password Service Account — sourced from file, not hardcoded
if test -r /etc/op-service-account-token
    set -gx OP_SERVICE_ACCOUNT_TOKEN (cat /etc/op-service-account-token)
end

